{
  "name": "librelinkward",
  "version": "0.4.2",
  "author": {
    "name": "Yannis Ioannidis",
    "email": "jfioannidis@gmail.com"
  },
  "homepage": "https://github.com/koumoutsas/LibreLinkWard",
  "main": "./.erb/dll/main.bundle.dev.js",
  "scripts": {
    "prebuild": "node ./prebuild/index.mjs",
    "build": "concurrently \"npm run build:main\" \"npm run build:renderer\"",
    "build:main": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.prod.ts",
    "build:renderer": "cross-env NODE_ENV=production TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.prod.ts",
    "postinstall": "ts-node .erb/scripts/check-native-dep.js && electron-builder install-app-deps && cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.renderer.dev.dll.ts",
    "lint": "cross-env NODE_ENV=development eslint .",
    "package": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build --publish never",
    "package-all": "ts-node ./.erb/scripts/clean.js dist && npm run build && electron-builder build -mwl --publish never",
    "rebuild": "electron-rebuild --parallel --types prod,dev,optional --module-dir release/app",
    "start": "ts-node ./.erb/scripts/check-port-in-use.js && npm run start:renderer",
    "start:main": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.main.dev.ts && electronmon .",
    "start:preload": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack --config ./.erb/configs/webpack.config.preload.dev.ts",
    "start:renderer": "cross-env NODE_ENV=development TS_NODE_TRANSPILE_ONLY=true webpack serve --config ./.erb/configs/webpack.config.renderer.dev.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "package:dir": "npm run build && electron-builder build --dir --publish never",
    "test:e2e": "playwright test",
    "test:e2e:local": "scripts/e2e-local.sh",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test:mutation": "stryker run",
    "deps:outdated": "npm outdated",
    "deps:deprecated": "node scripts/check-deprecated.js"
  },
  "browserslist": [],
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": [
          ".prettierrc"
        ],
        "options": {
          "parser": "json"
        }
      }
    ]
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "release/app/node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/.erb/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy",
      "^@/(.*)$": "<rootDir>/src/renderer/$1"
    },
    "collectCoverageFrom": [
      "src/shared/**/*.ts",
      "src/main/{alarmService,pollingService,credentialStore}.ts",
      "src/main/nightscout/*.ts",
      "src/renderer/lib/glucose.ts",
      "src/renderer/**/*.{ts,tsx}",
      "!src/renderer/components/ui/**",
      "!src/renderer/index.tsx",
      "!**/*.d.ts",
      "!**/__tests__/**",
      "!src/renderer/lib/trayManager.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 80,
        "functions": 90,
        "lines": 90
      }
    },
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testPathIgnorePatterns": [
      "release/app/dist",
      ".erb/dll",
      "<rootDir>/.stryker-tmp/",
      "/__tests__/helpers/",
      "<rootDir>/e2e/"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/src/__tests__/helpers/jestSetup.ts"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.1",
    "axios": "^1.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-debug": "^3.2.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.6.3",
    "i18next": "^24.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@svgr/webpack": "^8.1.0",
    "@teamsupercell/typings-for-css-modules-loader": "^2.5.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.10.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-test-renderer": "^18.3.1",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "browserslist-config-erb": "^0.0.3",
    "chalk": "4.1.2",
    "concurrently": "^9.1.2",
    "core-js": "^3.40.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "detect-port": "^2.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electronmon": "^2.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "file-loader": "^6.2.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.9.2",
    "npm-check-updates": "^17.1.14",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.4.2",
    "react-refresh": "^0.16.0",
    "react-test-renderer": "^18.3.1",
    "rimraf": "^6.0.1",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "tailwindcss": "3.4.17",
    "terser-webpack-plugin": "^5.3.11",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "url-loader": "^4.1.1",
    "webpack": "^5.97.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "productName": "LibreLinkWard",
    "appId": "io.github.koumoutsas.librelinkward",
    "asar": true,
    "asarUnpack": "**\\*.{node,dll}",
    "files": [
      "dist",
      "node_modules",
      "package.json"
    ],
    "afterSign": ".erb/scripts/notarize.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "type": "distribution",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/logo.png",
      "synopsis": "Fetches your blood sugar from LibreLinkUp",
      "maintainer": "Yannis Ioannidis <jfioannidis@gmail.com>",
      "vendor": "Yannis Ioannidis",
      "description": "This is a desktop application that fetches your blood sugar from LibreLinkUp. Developed by Yannis Ioannidis, based on LibreLinkUp Desktop by Crazy Marvin & Contributors.",
      "category": "Utility",
      "mimeTypes": [
        "application/x-librelinkup"
      ],
      "desktop": {
        "entry": {
          "Name": "LibreLinkWard",
          "Comment": "Fetches your blood sugar from LibreLinkUp"
        }
      },
      "executableArgs": []
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.deb"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.exe",
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LibreLinkWard"
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.msi",
      "shortcutName": "LibreLinkWard"
    },
    "directories": {
      "app": "release/app",
      "buildResources": "assets",
      "output": "release/build"
    },
    "extraResources": [
      "./assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "koumoutsas",
      "repo": "LibreLinkWard"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=20"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=7"
    }
  },
  "electronmon": {
    "patterns": [
      "!**/**",
      "src/main/**"
    ],
    "logLevel": "quiet"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
